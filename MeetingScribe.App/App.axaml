<Application x:Class="MeetingScribe.App.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MeetingScribe.App.Converters"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MeetingScribe.App/Styles/ControlStyles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://MeetingScribe.App/Styles/Theme.axaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:BoolToVisibleConverter x:Key="BoolToVisibleConverter"/>
            <conv:InverseBoolToVisibleConverter x:Key="InverseBoolToVisibleConverter"/>
            <conv:NullToVisibleConverter x:Key="NullToVisibleConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
