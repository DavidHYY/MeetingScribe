<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Multi-targeted on purpose: net10.0-windows is the TFM that actually ships today
      (Windows is the only platform verified end-to-end - device capture, real
      transcription, the installer). Plain net10.0 is what makes the eventual macOS
      build possible per PI's requirement, and is compiled here too - not just claimed -
      so the IAudioPlatform seam is proven to actually satisfy a non-Windows build, via
      the MeetingScribe.Audio.Mac stub, on every build of this solution.
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MeetingScribe.App</AssemblyName>
    <RootNamespace>MeetingScribe.App</RootNamespace>
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>
    <!-- UTF-8 everywhere is a hard project requirement (the box default codepage is
         cp950); pin the executable's default encodings so Console/File writes that
         don't specify an encoding explicitly still come out UTF-8, not cp950. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Classic reflection-based bindings, not compiled bindings - this port keeps the
         WPF-era {Binding Path} style throughout (no x:DataType needed on every view). -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <!--
    Multi-targeted on Windows only. net10.0-windows is the TFM that actually ships
    today (Windows is the only platform verified end-to-end - device capture, real
    transcription, the installer). On a non-Windows build host, net10.0-windows cannot
    be added: NAudio (pulled in transitively by MeetingScribe.Audio.Windows) depends on
    NAudio.WinForms, which requires the Microsoft.WindowsDesktop.App.WindowsForms
    FrameworkReference - a Windows-only targeting pack that does not exist on macOS/
    Linux SDKs, workload or no workload. So on non-Windows hosts this project builds
    only plain net10.0, wired to MeetingScribe.Audio.Mac - still a real, compiled proof
    that the IAudioPlatform seam holds on a non-Windows target, just without also
    forcing an impossible net10.0-windows leg on this host.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <!-- Reference BindingMode/ImmutableSolidColorBrush etc. via the Diagnostics
         package only in Debug so release builds/publishes stay smaller. -->
    <PackageReference Include="Avalonia.Diagnostics" Version="12.1.1" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MeetingScribe.Audio.Abstractions\MeetingScribe.Audio.Abstractions.csproj" />
    <ProjectReference Include="..\MeetingScribe.Whisper\MeetingScribe.Whisper.csproj" />
  </ItemGroup>

  <!-- App icon lives in the repo-level assets/ folder (shared master, see
       assets/icon.svg) rather than duplicated under this project. Linked in as
       an AvaloniaResource so MainWindow.axaml can reference it via
       avares://MeetingScribe.App/Assets/icon.ico for the title-bar/Alt-Tab icon,
       independently of the ApplicationIcon PE-resource embedding above (that
       one only fires for the net10.0-windows exe icon; this one is what
       Avalonia's cross-platform Window.Icon actually reads at runtime). -->
  <ItemGroup>
    <AvaloniaResource Include="..\assets\icon.ico" Link="Assets\icon.ico" />
  </ItemGroup>

  <!-- Platform audio provider: exactly one is wired in per TFM. This is the seam from
       Part 1 actually being exercised at build time, not just documented. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\MeetingScribe.Audio.Windows\MeetingScribe.Audio.Windows.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <ProjectReference Include="..\MeetingScribe.Audio.Mac\MeetingScribe.Audio.Mac.csproj" />
  </ItemGroup>

  <!-- Bootstrap/AudioPlatformProvider.*.cs picks which IAudioPlatform to construct;
       only the file matching the active TFM is compiled in. -->
  <ItemGroup>
    <Compile Remove="Bootstrap\AudioPlatformProvider.Windows.cs" Condition="'$(TargetFramework)' != 'net10.0-windows'" />
    <Compile Remove="Bootstrap\AudioPlatformProvider.Other.cs" Condition="'$(TargetFramework)' == 'net10.0-windows'" />
  </ItemGroup>

  <!--
    macOS .app bundle: MSBuild target, macOS-host-only - guarded on
    IsOSPlatform('OSX') using the exact same idiom already used elsewhere in this
    solution (MeetingScribe.Audio.Mac.csproj's BuildMacNativeAudioHelper target,
    MeetingScribe.Whisper.csproj's runtime-package selection) so it can never fire on
    the Windows build. `dotnet build MeetingScribeCS.sln` never invokes the Publish
    target at all, so this is inert there too - belt and suspenders.

    Fires after `dotnet publish -f net10.0 -r osx-arm64` (optionally with the
    self-contained flag set true) and turns the publish output into MeetingScribe.app:
      - Copies every published file into Contents/MacOS/.
      - Writes Contents/Info.plist from the committed Packaging/Info.plist template -
        CFBundleIdentifier (com.ohmplus.meetingscribe), CFBundleName/
        CFBundleDisplayName = MeetingScribe (see that file's doc comment: this, not
        anything Avalonia-side, is what fixes the process registering as "Avalonia
        Application" in the menu bar/Dock/Screen & System Audio Recording permission
        list - MeetingScribe repo issue #4), and NSMicrophoneUsageDescription (macOS
        won't show the mic TCC prompt at all without one).
      - Copies assets/icon.icns as the bundle icon, if it exists (generate it via
        `sh tools/generate_icns.sh` - see that script and tools/generate_icons.py).
        Skipped, not a build failure, when absent - the ask was "skip rather than
        block", and a missing custom icon still leaves a launchable, correctly-
        identified bundle.
      - Ad-hoc codesigns the whole bundle (codesign, forced, deep, ad-hoc identity).
        A stable CFBundleIdentifier/bundle path plus a signature (ad-hoc is enough) is
        what lets a TCC (mic/screen-recording) grant persist across relaunches -
        without a bundle identity at all, macOS has nothing stable to attach the
        grant to and re-prompts, or attributes the grant to whatever process
        launched it (e.g. Terminal), every time.

    A framework-dependent publish of this same bundle still won't launch against a
    Homebrew-only .NET install (missing_runtime - see issue #4); this target does not
    force self-contained publishing, it bundles whatever `dotnet publish` produced,
    but publishing self-contained is what actually makes the resulting .app
    launchable via `open` on a machine with no system-wide .NET at
    /usr/local/share/dotnet.
  -->
  <Target Name="CreateMacOSAppBundle"
          AfterTargets="Publish"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) AND $(RuntimeIdentifier.StartsWith('osx'))">
    <PropertyGroup>
      <!--
        Deliberately NOT "$(PublishDir)../MeetingScribe.app/": that directory
        (bin/$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/) already
        directly contains the published apphost executable named literally
        "MeetingScribe.App" (from AssemblyName above), and macOS's default
        case-insensitive-but-case-preserving APFS treats "MeetingScribe.App" and
        "MeetingScribe.app" as the same path - MakeDir on the latter collided with
        the former and failed with MSB3191 (verified: reproduced, then fixed by
        moving the bundle one directory deeper, into a fresh "bundle/" subfolder
        nothing else writes into). Putting the bundle in its own "bundle/"
        subdirectory of that same output folder avoids the collision entirely.
      -->
      <MacOSAppBundleDir Condition="'$(MacOSAppBundleDir)' == ''">$(PublishDir)../bundle/MeetingScribe.app/</MacOSAppBundleDir>
      <MacOSBundleContentsDir>$(MacOSAppBundleDir)Contents/</MacOSBundleContentsDir>
      <MacOSBundleMacOSDir>$(MacOSBundleContentsDir)MacOS/</MacOSBundleMacOSDir>
      <MacOSBundleResourcesDir>$(MacOSBundleContentsDir)Resources/</MacOSBundleResourcesDir>
      <MacOSBundleIconSource>$(MSBuildProjectDirectory)/../assets/icon.icns</MacOSBundleIconSource>
    </PropertyGroup>

    <!-- Rebuilt from scratch every publish so a stale file from a previous RID/config
         never lingers inside the bundle. -->
    <RemoveDir Directories="$(MacOSAppBundleDir)" Condition="Exists('$(MacOSAppBundleDir)')" />
    <MakeDir Directories="$(MacOSBundleMacOSDir)" />
    <MakeDir Directories="$(MacOSBundleResourcesDir)" />

    <ItemGroup>
      <MacOSPublishedFile Include="$(PublishDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(MacOSPublishedFile)"
          DestinationFolder="$(MacOSBundleMacOSDir)%(RecursiveDir)"
          SkipUnchangedFiles="true" />

    <Copy SourceFiles="$(MSBuildProjectDirectory)/Packaging/Info.plist" DestinationFolder="$(MacOSBundleContentsDir)" />

    <Copy SourceFiles="$(MacOSBundleIconSource)"
          DestinationFiles="$(MacOSBundleResourcesDir)icon.icns"
          Condition="Exists('$(MacOSBundleIconSource)')" />
    <Message Importance="high"
             Text="MeetingScribe.app: no icon.icns at $(MacOSBundleIconSource) - shipping without a custom bundle icon (run tools/generate_icns.sh to add one). Not a build failure."
             Condition="!Exists('$(MacOSBundleIconSource)')" />

    <!-- Ad-hoc sign (no Apple Developer identity available/required for local
         acceptance testing) - "-" is codesign's documented ad-hoc signing identity. -->
    <Exec Command="codesign --force --deep --sign - &quot;$(MacOSAppBundleDir)&quot;" />

    <Message Importance="high" Text="Created $(MacOSAppBundleDir) (ad-hoc signed)." />
  </Target>

</Project>
