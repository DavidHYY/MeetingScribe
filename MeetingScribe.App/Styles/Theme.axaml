<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Design tokens for the whole app: spacing scale, type scale, radii, and semantic colour
    brushes. Every view should reference these instead of per-control magic numbers/hex
    colours - that consistency is the difference between "homemade" and "built".

    Spacing/type/radius are not theme-variant dependent, so they live as plain top-level
    resources. Colour brushes flip with the active ThemeVariant via ThemeDictionaries below,
    so both light and dark look deliberate rather than one being an afterthought.
  -->

  <!-- Spacing scale (px) -->
  <x:Double x:Key="Space.XXS">2</x:Double>
  <x:Double x:Key="Space.XS">4</x:Double>
  <x:Double x:Key="Space.S">8</x:Double>
  <x:Double x:Key="Space.M">12</x:Double>
  <x:Double x:Key="Space.L">16</x:Double>
  <x:Double x:Key="Space.XL">24</x:Double>
  <x:Double x:Key="Space.XXL">32</x:Double>

  <!-- Type scale (px) -->
  <x:Double x:Key="Type.Display">26</x:Double>
  <x:Double x:Key="Type.H1">18</x:Double>
  <x:Double x:Key="Type.H2">12.5</x:Double>
  <x:Double x:Key="Type.Body">13</x:Double>
  <x:Double x:Key="Type.Caption">11</x:Double>
  <x:Double x:Key="Type.Mono">12</x:Double>

  <FontFamily x:Key="Font.Mono">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>

  <!-- Corner radii -->
  <CornerRadius x:Key="Radius.S">4</CornerRadius>
  <CornerRadius x:Key="Radius.M">8</CornerRadius>
  <CornerRadius x:Key="Radius.L">10</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">10</CornerRadius>

  <ResourceDictionary.ThemeDictionaries>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="App.WindowBackground">#F3F4F6</SolidColorBrush>
      <SolidColorBrush x:Key="App.Surface">#FFFFFF</SolidColorBrush>
      <SolidColorBrush x:Key="App.SurfaceAlt">#F6F7F9</SolidColorBrush>
      <SolidColorBrush x:Key="App.SurfaceSunken">#EDEFF2</SolidColorBrush>
      <SolidColorBrush x:Key="App.Border">#E1E4E9</SolidColorBrush>
      <SolidColorBrush x:Key="App.BorderStrong">#C6CBD3</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextPrimary">#1A1D23</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextSecondary">#636B79</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextTertiary">#8C93A1</SolidColorBrush>
      <SolidColorBrush x:Key="App.Accent">#2E6BE6</SolidColorBrush>
      <SolidColorBrush x:Key="App.AccentSoft">#E8EFFD</SolidColorBrush>
      <SolidColorBrush x:Key="App.Success">#1E8E3E</SolidColorBrush>
      <SolidColorBrush x:Key="App.SuccessSoft">#E4F5EA</SolidColorBrush>
      <SolidColorBrush x:Key="App.Recording">#D8342A</SolidColorBrush>
      <SolidColorBrush x:Key="App.RecordingSoft">#FBE7E5</SolidColorBrush>
      <SolidColorBrush x:Key="App.Busy">#B8790C</SolidColorBrush>
      <SolidColorBrush x:Key="App.BusySoft">#FBF0DD</SolidColorBrush>
      <SolidColorBrush x:Key="App.Error">#C5221F</SolidColorBrush>
      <SolidColorBrush x:Key="App.ErrorSoft">#FCE8E6</SolidColorBrush>
      <SolidColorBrush x:Key="App.Idle">#8C93A1</SolidColorBrush>
      <SolidColorBrush x:Key="App.MeterTrack">#E1E4E9</SolidColorBrush>
      <SolidColorBrush x:Key="App.Mic">#2E6BE6</SolidColorBrush>
      <SolidColorBrush x:Key="App.System">#C1670C</SolidColorBrush>
      <SolidColorBrush x:Key="App.Translation">#5B4FCF</SolidColorBrush>
      <BoxShadows x:Key="App.CardShadow">0 1 3 0 #15000000</BoxShadows>
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="App.WindowBackground">#18191D</SolidColorBrush>
      <SolidColorBrush x:Key="App.Surface">#212227</SolidColorBrush>
      <SolidColorBrush x:Key="App.SurfaceAlt">#26272D</SolidColorBrush>
      <SolidColorBrush x:Key="App.SurfaceSunken">#1E1F24</SolidColorBrush>
      <SolidColorBrush x:Key="App.Border">#35363D</SolidColorBrush>
      <SolidColorBrush x:Key="App.BorderStrong">#45474F</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextPrimary">#F1F2F4</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextSecondary">#A2A8B3</SolidColorBrush>
      <SolidColorBrush x:Key="App.TextTertiary">#7C828D</SolidColorBrush>
      <SolidColorBrush x:Key="App.Accent">#6C9BFF</SolidColorBrush>
      <SolidColorBrush x:Key="App.AccentSoft">#233150</SolidColorBrush>
      <SolidColorBrush x:Key="App.Success">#5FD088</SolidColorBrush>
      <SolidColorBrush x:Key="App.SuccessSoft">#1D3327</SolidColorBrush>
      <SolidColorBrush x:Key="App.Recording">#FF6B62</SolidColorBrush>
      <SolidColorBrush x:Key="App.RecordingSoft">#3B2323</SolidColorBrush>
      <SolidColorBrush x:Key="App.Busy">#E4B34E</SolidColorBrush>
      <SolidColorBrush x:Key="App.BusySoft">#3A3020</SolidColorBrush>
      <SolidColorBrush x:Key="App.Error">#FF7A72</SolidColorBrush>
      <SolidColorBrush x:Key="App.ErrorSoft">#3A2422</SolidColorBrush>
      <SolidColorBrush x:Key="App.Idle">#7C828D</SolidColorBrush>
      <SolidColorBrush x:Key="App.MeterTrack">#35363D</SolidColorBrush>
      <SolidColorBrush x:Key="App.Mic">#6C9BFF</SolidColorBrush>
      <SolidColorBrush x:Key="App.System">#E0A45C</SolidColorBrush>
      <SolidColorBrush x:Key="App.Translation">#B4A7F5</SolidColorBrush>
      <BoxShadows x:Key="App.CardShadow">0 1 3 0 #40000000</BoxShadows>
    </ResourceDictionary>

  </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
