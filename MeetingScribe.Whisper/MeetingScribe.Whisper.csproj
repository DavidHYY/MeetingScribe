<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Whisper.net" Version="1.9.1" />
  </ItemGroup>

  <!--
    Native runtime package is host-OS conditional: Vulkan is the Windows Intel-GPU path and
    does not exist/build for macOS. On macOS the plain "Whisper.net.Runtime" package already
    bundles libggml-metal-whisper.dylib for macos-arm64 (confirmed by inspecting the 1.9.1
    .nupkg directly — build/macos-arm64/libggml-metal-whisper.dylib is present), so Metal
    acceleration comes for free with no extra package. Whisper.net.Runtime.Vulkan is Windows-
    only unconditional today and stays exactly as-is on Windows; this only changes what gets
    restored on other host OSes.

    Whisper.net.Runtime.CoreML (also confirmed present at 1.9.1) was deliberately NOT used
    here: whisper.cpp's CoreML encoder path needs a separate ggml-<model>-encoder.mlmodelc
    bundle generated from the ggml model via whisper.cpp's own coreml-model conversion script
    (Python + coremltools + Xcode toolchain), which is not fetched or generated by this build.
    Referencing Whisper.net.Runtime.CoreML without that file present would just recreate a
    "package referenced but not the thing that loads" scenario. The plain Metal path already
    measured for this task works without any extra assets, so it is the macOS default.

    Limitation: this condition evaluates at build time on the machine doing the build, not at
    runtime. A Whisper.net.Runtime.Vulkan build produced on Windows does not carry a macOS-
    capable native runtime, and vice versa - there is no cross-compiled single artifact here.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <!--
    Whisper.net.Runtime.Vulkan 1.9.1 ships its Linux-x64 native runtime
    (runtimes/vulkan/linux-x64/*.so, ~58 MB) unconditionally. Verified by
    reading the installed package directly
    (~/.nuget/packages/whisper.net.runtime.vulkan/1.9.1/build/
    Whisper.net.Runtime.Vulkan.targets): the win-x64 None items are gated on
    Condition="$(TargetFramework.Contains('-windows')) == true or ...", but
    the linux-x64 block has NO Condition at all - it is added to every
    build/publish that references this package, regardless of TFM or RID.
    This project only references the package on a Windows build host
    (ItemGroup above), and the only shipping consumer (MeetingScribe.App's
    net10.0-windows target) never runs on Linux, so those .so files are
    always dead weight. Strip them at the source so no downstream
    build/publish/installer has to filter them out individually.
  -->
  <Target Name="RemoveLinuxVulkanRuntimeNoneItems" BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems;Build;Publish">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="$([System.String]::Copy('%(None.TargetPath)').Replace('\', '/').StartsWith('runtimes/vulkan/linux-x64'))" />
    </ItemGroup>
  </Target>

</Project>
